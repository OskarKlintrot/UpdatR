<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="CSharpier.MSBuild" Version="1.3.0" />
    <PackageVersion Include="Markdig" Version="1.5.0" />
    <PackageVersion Include="Microsoft.Build" Version="18.9.6" />
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageVersion Include="Microsoft.Build.Tasks.Git" Version="10.0.403" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.14" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.SourceLink.Common" Version="10.0.403" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.403" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
    <PackageVersion Include="NuGet.Credentials" Version="7.9.0" />
    <PackageVersion Include="NuGet.Frameworks" Version="7.9.0" />
    <PackageVersion Include="NuGet.Protocol" Version="7.9.0" />
    <PackageVersion Include="NuGet.Versioning" Version="7.9.0" />
    <PackageVersion Include="SimpleExec" Version="13.1.0" />
    <PackageVersion Include="System.CommandLine" Version="2.0.14" />
    <PackageVersion Include="Verify.XunitV3" Version="32.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      NuGet.Protocol 7.9.0 pulls in System.Security.Cryptography.Pkcs 8.0.1 via NuGet.Packaging.
      Pin the patched version until NuGet updates its dependency to fix these DoS vulnerabilities:
      https://github.com/advisories/GHSA-2fmv-rv2c-59x7
      https://github.com/advisories/GHSA-846f-f764-76mx
      Transitive pinning also promotes this dependency into the packed UpdatR package.
    -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
</Project>
