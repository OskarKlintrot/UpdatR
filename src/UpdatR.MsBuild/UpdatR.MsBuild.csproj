<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      Prototype: isolated on purpose. Microsoft.Build ships its own copies of several NuGet
      client libraries (NuGet.Frameworks, NuGet.Versioning, etc.). UpdatR itself references those
      same packages directly, so if this project referenced UpdatR (or vice versa) both copies
      could end up loaded in the same process and conflict. Keeping this project free of any
      NuGet.* package references avoids that entirely.
    -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build" Version="18.9.6" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
  </ItemGroup>
</Project>
