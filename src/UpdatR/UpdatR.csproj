<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\BuildingBlocks\BuildingBlocks.projitems" Label="Shared" />

  <Import Project="$(MSBuildProjectDirectory)\..\Build\nuget.props" />

  <PropertyGroup>
    <PackageId>UpdatR</PackageId>
    <Description>Package to update NuGet packages. Supports package references and dotnet-tools.json.</Description>
    <PackageTags>Update,NuGet,Packages,CI,CD</PackageTags>
    <GeneratePackageOnBuild Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'"
      >true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="NuGet.Credentials" Version="7.9.0" />
    <!--
      NuGet.Frameworks is one of the packages Microsoft.Build.Locator (brought in transitively via
      the ProjectReference below) warns about (MSBL001): MSBuild ships its own copy internally, so
      this one must not be copied to the output directory. ExcludeAssets="runtime" achieves that,
      and PrivateAssets="all" stops the reference from flowing to downstream consumers (so their
      own builds don't trip the same MSBL001 check for a package they never asked for). UpdatR's
      own use of NuGet.Frameworks (internal only, never part of the public API) is safe because
      ModuleInitializer.cs registers MSBuildLocator's assembly-resolve handler before any code in
      this assembly can run, guaranteeing the "excluded" NuGet.Frameworks gets resolved from
      whatever .NET SDK/Visual Studio installation MSBuildLocator finds instead.
    -->
    <PackageReference
      Include="NuGet.Frameworks"
      Version="7.9.0"
      ExcludeAssets="runtime"
      PrivateAssets="all"
    />
    <PackageReference Include="NuGet.Protocol" Version="7.9.0" />
    <PackageReference Include="NuGet.Versioning" Version="7.9.0" />
    <!--
      Microsoft.Build ships its own copies of several NuGet client libraries (NuGet.Frameworks,
      NuGet.Versioning, etc.) and, once MSBuildLocator is registered, redirects any request for
      those assemblies (process-wide) to whatever .NET SDK/Visual Studio installation it finds.
      UpdatR itself references the same NuGet client packages directly to talk to NuGet feeds, so
      Microsoft.Build's own copies must never be copied to this project's output - ExcludeAssets
      ="runtime" achieves that, the same way it's used for NuGet.Frameworks above. Unlike
      NuGet.Frameworks, downstream consumers never need Microsoft.Build at all (it's used only by
      MsBuildProjectInspector.cs, entirely internal), so PrivateAssets="all" is also set.
    -->
    <PackageReference
      Include="Microsoft.Build"
      Version="18.9.6"
      ExcludeAssets="runtime"
      PrivateAssets="all"
    />
  </ItemGroup>

  <ItemGroup>
    <!--
      Microsoft.Build.Locator.dll must physically ship next to UpdatR.dll (ModuleInitializer.cs
      calls into it unconditionally). It is intentionally NOT declared as a normal dependency here:
      Microsoft.Build.Locator ships its own buildTransitive\Microsoft.Build.Locator.targets file,
      which fails the build (MSBL001) of ANY project that ends up depending on Microsoft.Build.Locator
      - directly or transitively - unless every PackageReference to an assembly MSBuild ships its own
      copy of (NuGet.Frameworks and Microsoft.Build itself among them) has ExcludeAssets="runtime"
      and PrivateAssets="all" set. That metadata does not flow transitively (see the
      NuGet.Frameworks comment above), so if Microsoft.Build.Locator flowed to consumers as a normal
      dependency, EVERY consumer of the UpdatR package would fail to build with MSBL001, through no
      fault of their own, as soon as they add a PackageReference to UpdatR (confirmed: there is
      currently no way, via buildTransitive or otherwise, to make the required exclusion metadata
      flow transitively - see https://github.com/microsoft/MSBuildLocator/issues/364).
      PrivateAssets="all" keeps Microsoft.Build.Locator out of UpdatR's nuspec entirely, so its
      buildTransitive check never even gets imported into a consumer's build. The
      CopyMicrosoftBuildLocatorToPackage target below bundles its compiled output directly into
      UpdatR's own package instead, so UpdatR.dll's ModuleInitializer still finds it at run-time
      without consumers ever restoring the package themselves.
    -->
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" PrivateAssets="all" />
  </ItemGroup>

  <!--
    NuGet only bundles a package's own compiled output into its .nupkg automatically - not the
    output of a PrivateAssets="all" dependency like Microsoft.Build.Locator above (see
    https://learn.microsoft.com/nuget/create-packages/set-package-type#including-referenced-projects-in-the-nuget-package,
    which describes the same restriction for ProjectReference). This target copies
    Microsoft.Build.Locator.dll into UpdatR's package alongside UpdatR.dll, so UpdatR.dll's
    ModuleInitializer can still find and load it at run-time (see the PrivateAssets="all" comment
    above for why it isn't a normal dependency).
  -->
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>
      $(TargetsForTfmSpecificBuildOutput);CopyMicrosoftBuildLocatorToPackage
    </TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <Target
    Name="CopyMicrosoftBuildLocatorToPackage"
    DependsOnTargets="ResolveReferences;ResolvePackageAssets"
  >
    <ItemGroup>
      <!--
        UpdatR is a class library, so Microsoft.Build.Locator.dll is never copy-local to UpdatR's
        own build output (that only happens for executable projects) - RuntimeCopyLocalItems still
        lists it (with its resolved path) regardless, which is what's needed here.
      -->
      <BuildOutputInPackage Include="@(RuntimeCopyLocalItems->WithMetadataValue('NuGetPackageId', 'Microsoft.Build.Locator'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>$(MSBuildProjectName).UnitTests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>$(RootNamespace).UnitTests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>$(MSBuildProjectName).IntegrationTests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>$(RootNamespace).IntegrationTests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <!-- For Moq -->
      <_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
