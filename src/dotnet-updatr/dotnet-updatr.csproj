<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\BuildingBlocks\BuildingBlocks.projitems" Label="Shared" />

  <Import Project="$(MSBuildProjectDirectory)\..\Build\nuget.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>dotnet-updatr</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>update</ToolCommandName>
    <Description>Tool to update NuGet packages. Supports package references and dotnet-tools.json.</Description>
    <PackageTags>Update,NuGet,Packages,CI,CD</PackageTags>
    <GeneratePackageOnBuild Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'"
      >true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
    <PackageReference Include="NuGet.Credentials" Version="7.9.0" />
    <!--
      NuGet.Protocol depends on NuGet.Frameworks itself, so it must be pinned and excluded here
      too, otherwise it flows in as a normal (non-excluded) transitive dependency of NuGet.Protocol,
      independently of the exclusion in ..\UpdatR\UpdatR.csproj. See the comment there for why.
      dotnet-updatr itself never uses NuGet.Frameworks types directly (it only goes through
      UpdatR's public API), so no extra registration guard is needed here - UpdatR.dll's own
      ModuleInitializer covers it.
    -->
    <PackageReference
      Include="NuGet.Frameworks"
      Version="7.9.0"
      ExcludeAssets="runtime"
      PrivateAssets="all"
    />
    <PackageReference Include="NuGet.Protocol" Version="7.9.0" />
    <PackageReference Include="NuGet.Versioning" Version="7.9.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UpdatR\UpdatR.csproj" />
  </ItemGroup>
</Project>
